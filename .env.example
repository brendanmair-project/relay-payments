# Relay settings. Copy this file to .env (cp .env.example .env); only this example is committed.
# Every variable is described in docs/architecture/containers.md (Configuration) and ADR-0011.
# The key below is a local-only placeholder: change it before sharing the stack with anyone.
RELAY_API_KEY=local-dev-only-key-change-me

# Databases (local only). The postgres init script creates relay_test on a fresh volume.
POSTGRES_PASSWORD=relay
DATABASE_URL=postgresql+psycopg://relay:relay@postgres:5432/relay
TEST_DATABASE_URL=postgresql+psycopg://relay:relay@postgres:5432/relay_test
REDIS_URL=redis://redis:6379/0
TEST_REDIS_URL=redis://redis:6379/1

# Service addresses inside the compose network
API_URL=http://api:8000
SIMULATOR_URL=http://simulator:8100
SIMULATOR_CONTROL_URL=http://simulator:8101
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=granite3.3:2b

# Processing (used from REL-19 on)
ROUTING_STRATEGY=rules
PROCESSOR_TIMEOUT_SECONDS=5
SWEEP_TIMEOUT_GRACE_SECONDS=5
REDRIVE_AFTER_SECONDS=30
SWEEP_INTERVAL_SECONDS=5
RECLAIM_IDLE_MS=30000
STREAM_MAXLEN=10000
HEALTH_WINDOW_SECONDS=60
HEALTH_MIN_ATTEMPTS=5
HEALTH_ERROR_THRESHOLD=0.5
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LEASE_SECONDS=30
KEY_CLEANUP_INTERVAL_SECONDS=60
EXPLAIN_TIMEOUT_SECONDS=20
SIM_SEED=42

# Host ports (bound to 127.0.0.1)
FRONTEND_HOST_PORT=3000
API_HOST_PORT=8000
SIM_CONTROL_HOST_PORT=8101
